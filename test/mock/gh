#!/usr/bin/env bash

# Mock gh: logs every invocation to ${MOCK_LOG}, serves canned JSON for
# view/list queries from the per-case fixture files exported by the
# harness (test/lib.sh), and lets mutating calls (label edits, comments,
# ...) succeed silently so the log is the only trace of them.
#
# Setting MOCK_GH_FAIL to a non-empty value makes every call fail, to
# simulate API failures.
#
# This is an executable, not a shell function, and it is only ever put on
# PATH by the spec process, so it cannot leak into an interactive shell.

if [[ -n "${MOCK_LOG:-}" ]]; then
    echo "gh $*" >>"${MOCK_LOG}"
fi

if [[ -n "${MOCK_GH_FAIL:-}" ]]; then
    echo "mock gh: simulated failure: gh $*" >&2
    exit 1
fi

# The real gh applies the --jq filter to the JSON reply; do the same to
# the fixture so scripts using --jq see what they expect.
jq_filter=""
prev=""
for arg in "$@"; do
    if [[ "${prev}" == "--jq" || "${prev}" == "-q" ]]; then
        jq_filter="${arg}"
    fi
    prev="${arg}"
done

# serve <fixture-file>: print a fixture, through the --jq filter if one
# was given. A query without a fixture fails like a 404 so that specs
# never silently run against missing data.
function serve() {
    local fixture="${1:-}"
    if [[ -z "${fixture}" || ! -f "${fixture}" ]]; then
        echo "mock gh: no fixture for: gh $*" >&2
        exit 1
    fi
    if [[ -n "${jq_filter}" ]]; then
        jq -r "${jq_filter}" "${fixture}"
    else
        cat "${fixture}"
    fi
}

case "$*" in
*"--json body,labels"*)
    serve "${MOCK_PR_JSON:-}"
    ;;
*"--json isDraft,title,labels"*)
    serve "${MOCK_WIP_JSON:-}"
    ;;
*"--json additions,deletions,labels"*)
    serve "${MOCK_SIZE_JSON:-}"
    ;;
*"--json labels"*)
    serve "${MOCK_LABELS_JSON:-}"
    ;;
*"--json name"*)
    # gh label list --json name: the repository's existing labels.
    serve "${MOCK_LABEL_LIST_JSON:-}"
    ;;
*"--json baseRefName"*)
    # Base branch of the PR; defaults to main.
    if [[ -n "${MOCK_PR_BASE_JSON:-}" && -f "${MOCK_PR_BASE_JSON:-}" ]]; then
        serve "${MOCK_PR_BASE_JSON}"
    else
        echo '{"baseRefName":"main"}'
    fi
    ;;
"api /user"*)
    echo '{"login":"mock-bot"}'
    ;;
*"/pulls/"*"/files"*)
    # Changed files of the PR; defaults to no changed files.
    if [[ -n "${MOCK_PR_FILES_JSON:-}" && -f "${MOCK_PR_FILES_JSON:-}" ]]; then
        serve "${MOCK_PR_FILES_JSON}"
    fi
    ;;
*"/contents/"*)
    # OWNERS file fetches. MOCK_OWNERS_FAIL simulates a non-404 API
    # failure (MOCK_OWNERS_FAIL_PATH: only for that path). MOCK_OWNERS_DIR
    # serves per-path fixtures named after the path with "/" replaced by
    # "__" (e.g. src__OWNERS); MOCK_OWNERS_FILE serves the same content
    # for every path. Without a fixture the file is absent, reported like
    # the real gh: HTTP 404.
    path=""
    for arg in "$@"; do
        if [[ "${arg}" == *"/contents/"* ]]; then
            path="${arg#*/contents/}"
        fi
    done
    if [[ -n "${MOCK_OWNERS_FAIL:-}" ]] ||
        [[ -n "${MOCK_OWNERS_FAIL_PATH:-}" && "${path}" == "${MOCK_OWNERS_FAIL_PATH:-}" ]]; then
        echo "mock gh: simulated failure: gh $*" >&2
        exit 1
    fi
    if [[ -n "${MOCK_OWNERS_DIR:-}" && -f "${MOCK_OWNERS_DIR}/${path//\//__}" ]]; then
        cat "${MOCK_OWNERS_DIR}/${path//\//__}"
    elif [[ -n "${MOCK_OWNERS_FILE:-}" && -f "${MOCK_OWNERS_FILE:-}" ]]; then
        cat "${MOCK_OWNERS_FILE}"
    else
        echo "gh: Not Found (HTTP 404)" >&2
        exit 1
    fi
    ;;
"api --paginate /repos/"*"/issues/"*"/comments")
    # Issue comment listing (find_status_comment); defaults to none.
    # Comment POST/PATCH calls carry -X and fall through to the
    # log-only mutation case instead. MOCK_COMMENTS_FAIL simulates a
    # failed comment read.
    if [[ -n "${MOCK_COMMENTS_FAIL:-}" ]]; then
        echo "mock gh: simulated failure: gh $*" >&2
        exit 1
    fi
    if [[ -n "${MOCK_COMMENTS_JSON:-}" && -f "${MOCK_COMMENTS_JSON:-}" ]]; then
        serve "${MOCK_COMMENTS_JSON}"
    else
        echo '[]'
    fi
    ;;
"api /repos/"*"/issues/comments/"*)
    # Single comment fetch by id: serves the first fixture comment.
    if [[ -n "${MOCK_COMMENTS_FAIL:-}" ]]; then
        echo "mock gh: simulated failure: gh $*" >&2
        exit 1
    fi
    if [[ -n "${MOCK_COMMENTS_JSON:-}" && -f "${MOCK_COMMENTS_JSON:-}" ]]; then
        if [[ -n "${jq_filter}" ]]; then
            jq -r ".[0] | ${jq_filter}" "${MOCK_COMMENTS_JSON}"
        else
            jq '.[0]' "${MOCK_COMMENTS_JSON}"
        fi
    else
        echo "mock gh: no fixture for: gh $*" >&2
        exit 1
    fi
    ;;
"api /repos/"*)
    # Repository metadata, used to resolve the default branch.
    echo '{"default_branch":"main"}'
    ;;
*)
    # Mutations (label edits, comments, label create, ...): log only.
    # MOCK_MUTATE_FAIL makes them fail, to test write guards.
    if [[ -n "${MOCK_MUTATE_FAIL:-}" ]]; then
        echo "mock gh: simulated mutation failure: gh $*" >&2
        exit 1
    fi
    ;;
esac
